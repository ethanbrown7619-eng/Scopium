# Postgres (with pgvector). Locally: docker run pgvector/pgvector:pg16.
# In production: Supabase session-pooler URL.
DATABASE_URL=postgres://scopium:scopium@localhost:5432/scopium

# AI provider for the Cmd-K Ask palette. Pick one:
#   AI_PROVIDER=anthropic   AI_API_KEY=sk-ant-...
#   AI_PROVIDER=openai      AI_API_KEY=sk-...
#   AI_PROVIDER=google      AI_API_KEY=AIza...
# AI_MODEL overrides the default for the chosen provider:
#   anthropic default: claude-sonnet-4-6
#   openai default:    gpt-4o
#   google default:    gemini-2.5-pro
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# Connector base URLs (defaults work without an account, but rate-limited).
NZ_COMPANIES_REGISTER_BASE=https://api.companiesoffice.govt.nz/companies/v1
NZ_COMPANIES_REGISTER_TOKEN=

STATSNZ_API_BASE=https://api.stats.govt.nz/opendata/v1
STATSNZ_API_KEY=

LINZ_API_BASE=https://data.linz.govt.nz/services
LINZ_API_KEY=

CKAN_BASE=https://catalogue.data.govt.nz/api/3
