# Postgres (with pgvector + Apache AGE recommended; AGE is optional — query layer falls back to recursive CTEs)
DATABASE_URL=postgres://scopium:scopium@localhost:5432/scopium

# Anthropic API key for the Ask palette (Claude Sonnet 4.6 by default)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Companies Register — public endpoints; bearer optional for higher quotas
NZ_COMPANIES_REGISTER_BASE=https://api.companiesoffice.govt.nz/companies/v1
NZ_COMPANIES_REGISTER_TOKEN=

# StatsNZ Open Data
STATSNZ_API_BASE=https://api.stats.govt.nz/opendata/v1
STATSNZ_API_KEY=

# LINZ Data Service
LINZ_API_BASE=https://data.linz.govt.nz/services
LINZ_API_KEY=

# data.govt.nz CKAN
CKAN_BASE=https://catalogue.data.govt.nz/api/3
