{
  "name": "scopium",
  "version": "0.1.0",
  "private": true,
  "description": "Scopium — ontology-driven data integration and analysis for Aotearoa New Zealand",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @scopium/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @scopium/web test:e2e",
    "db:push": "pnpm --filter @scopium/web db:push",
    "db:seed": "pnpm --filter @scopium/web db:seed",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5",
    "vitest": "2.1.3",
    "tsx": "4.19.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
